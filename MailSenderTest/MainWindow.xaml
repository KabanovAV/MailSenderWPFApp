<Window x:Class="MailSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MailSender" xmlns:viewmodel="clr-namespace:MailSenderTest.MVVM.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewmodel:ApplicationViewModel}"
        mc:Ignorable="d"
        Title="Mail Sender" Height="567" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="165*"/>
            <ColumnDefinition Width="165*"/>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="391*"/>
            <RowDefinition Height="52*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <TextBox Text="{Binding ToSetting.To, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="30" VerticalAlignment="Top" VerticalContentAlignment="Center" Margin="19,1,9,0" Grid.Row="2" FontSize="14" Grid.ColumnSpan="2"/>
        <Label Content="Кому" Width="45" HorizontalAlignment="Left" FontSize="14" VerticalAlignment="Center" Height="35" Grid.Row="1" Grid.ColumnSpan="2" Margin="19,0,0,0"/>
        <TextBox Text="{Binding ToSetting.Subject, UpdateSourceTrigger=PropertyChanged}" Margin="318,1,8,0" TextWrapping="Wrap" Height="30" VerticalAlignment="Top" VerticalContentAlignment="Center" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" FontSize="14"/>
        <Label Content="Тема" HorizontalAlignment="Left" VerticalAlignment="Center" Height="35" Width="45" Grid.Column="1" Grid.Row="1" FontSize="14" Grid.ColumnSpan="2" Margin="318,0,0,0"/>
        <Button Content="Выбрать папку" Command="{Binding ChooseFolder}" Height="54" VerticalAlignment="Top" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Margin="318,10,1,0" Grid.ColumnSpan="2"/>
        <ProgressBar Value="{Binding Parameter.Progress, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" Height="33" VerticalAlignment="Center" Grid.Row="5" Grid.ColumnSpan="2" Margin="1,0,10,0" Grid.Column="1"/>
        <Button Content="Отправить" Command="{Binding SentMail}" Height="33" VerticalAlignment="Center" Grid.Row="5" Grid.Column="3" Margin="4,0,19,0" Grid.ColumnSpan="2"/>
        <ListView Grid.Column="1" Grid.Row="3" ItemsSource="{Binding Statuses}" Grid.ColumnSpan="3" Margin="1,29,1,51" Grid.RowSpan="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Title}" Width="350" Header="Название" />
                    <GridViewColumn DisplayMemberBinding="{Binding Status}" Width="100" Header="Статус" />
                    <GridViewColumn DisplayMemberBinding="{Binding Time, StringFormat='dd-MM-yyyy HH:mm'}" Width="150" Header="Время"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="1,0,0,0" Grid.Row="3" TextWrapping="Wrap" Text="Путь:" VerticalAlignment="Center" Height="20" Width="35"/>
        <TextBlock Grid.Column="1" Margin="36,0,0,0" Grid.Row="3" TextWrapping="Wrap" Text="{Binding ToSetting.FolderPath, UpdateSourceTrigger=PropertyChanged, TargetNullValue=Папка не выбрана}" VerticalAlignment="Center" Height="20" Grid.ColumnSpan="2"/>

    </Grid>
</Window>
